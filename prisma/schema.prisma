generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Better-Auth Core Tables ───

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions         Session[]
  accounts         Account[]
  settings         UserSettings?
  preferences      UserPreferences?
  deezerCred       DeezerCredential?
  playlists        Playlist[]
  savedTracks      SavedTrack[]
  savedAlbums      Album[]
  followedArtists  FollowedArtist[]
  sharedTracks     SharedTrack[]
  recentPlays      RecentPlay[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// Signing keys of the better-auth `jwt` plugin (JWTs for Convex, docs/adr/0002).
model Jwks {
  id         String    @id @default(cuid())
  publicKey  String
  privateKey String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

// ─── Legacy Config Table (used by Spotify plugin & global settings) ───

model Config {
  userId    String   @default("default") @map("user_id")
  key       String
  value     Json
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@id([userId, key])
  @@map("config")
}

// ─── Application Tables ───

model DeezerCredential {
  id                String   @id @default(cuid())
  userId            String   @unique
  /// ARL cookie; "enc:v1:…" (AES-256-GCM, src/lib/secret-box.ts) or legacy plaintext.
  arl               String
  /// Selected family / child account index, restored on every re-login.
  childAccount      Int      @default(0)
  deezerUserId      BigInt?
  deezerUserName    String?
  deezerPicture     String?
  canStreamHq       Boolean  @default(false)
  canStreamLossless Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("deezer_credential")
}

model UserSettings {
  id       String @id @default(cuid())
  userId   String @unique
  settings Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model UserPreferences {
  id          String   @id @default(cuid())
  userId      String   @unique
  preferences Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ─── User Library ───
//
// Spotify-like model:
//   • SavedTrack = explicitly liked tracks (≈ "Liked Songs")
//   • Album      = saved albums + their tracklist (Spotify "Your Library > Albums")
//   • Playlist   = user-created playlists (or saved public ones)
//
// File persistence is orthogonal — see StoredTrack. A saved track may or may
// not have a backing audio file; playback is always served via the progressive
// streaming engine which fetches/persists/evicts files transparently.

model Playlist {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  coverUrl    String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks PlaylistTrack[]

  @@map("playlist")
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  trackId    String
  title      String
  artist     String
  album      String?
  albumId    String?
  coverUrl   String?
  duration   Int?
  position   Int
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@map("playlist_track")
}

model SavedTrack {
  id        String   @id @default(cuid())
  userId    String
  trackId   String
  title     String
  artist    String
  album     String?
  albumId   String?
  coverUrl  String?
  duration  Int?
  savedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId, savedAt(sort: Desc)])
  @@index([trackId])
  @@map("saved_track")
}

model Album {
  id            String   @id @default(cuid())
  userId        String
  deezerAlbumId String
  title         String
  artist        String
  coverUrl      String?
  trackCount    Int      @default(0)
  savedAt       DateTime @default(now())

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks AlbumTrack[]

  @@unique([userId, deezerAlbumId])
  @@index([userId, savedAt(sort: Desc)])
  @@map("album")
}

model AlbumTrack {
  id          String  @id @default(cuid())
  albumId     String
  trackId     String
  title       String
  artist      String
  coverUrl    String?
  duration    Int?
  trackNumber Int?

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([albumId, trackId])
  @@index([trackId])
  @@map("album_track")
}

// ─── Followed Artists ───
//
// Spotify-like "Following" list — a flat metadata table. The Deezer artist
// id is the upstream identity; we cache the display name and picture so
// listing the user's followed artists doesn't require a Deezer round-trip.
// No file-lifecycle implications: following an artist never anchors any
// StoredTrack.

model FollowedArtist {
  id              String   @id @default(cuid())
  userId          String
  deezerArtistId  String
  name            String
  pictureUrl      String?
  followedAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deezerArtistId])
  @@index([userId, followedAt(sort: Desc)])
  @@map("followed_artist")
}

// ─── File Cache (server-side, transparent to user) ───
//
// Global cache of audio files persisted to S3/local. Keyed by trackId+bitrate
// so the same file can serve multiple users (dedup). Lifecycle is automatic:
//   • populated on first play via /api/v1/stream-progressive
//   • evicted when a play is skipped <30s OR when the user's recent-plays
//     cap (100) pushes it out
//   • re-fetched on demand when an evicted track is replayed
//
// Ref-counted via SavedTrack[trackId], AlbumTrack[trackId], SharedTrack[trackId],
// RecentPlay[trackId]. When all refs drop, the file becomes orphan and is
// safe to delete (handled by the eviction helper).

//
// storagePath: new copies use "tracks/{trackId}/{bitrate}{ext}" (unique per
// row); legacy rows keep their old template path ("music/...").
// requestedBitrate: quality the persisting play asked for, i.e.
// min(server maxBitrate, persisting account's licence). A copy is good enough
// for a listener whose own cap is <= this even when Deezer only had a lower
// bitrate (see storage/cached-copy.ts). null = legacy row (use `bitrate`).

model StoredTrack {
  id               String   @id @default(cuid())
  trackId          String
  bitrate          Int
  storagePath      String
  storageType      String
  fileSize         Int?
  requestedBitrate Int?
  createdAt        DateTime @default(now())

  sharedTracks SharedTrack[]

  @@unique([trackId, bitrate])
  @@index([trackId])
  @@index([storagePath])
  @@map("stored_track")
}

// ─── Persist lease (cross-instance dedup of progressive persists) ───
//
// One row per (trackId, requested bitrate) while a progressive play is
// downloading + uploading that track. Acquired with an atomic insert (or a
// conditional takeover once expiresAt has passed), released in a finally.
// expiresAt outlives the route's maxDuration, so a killed holder never blocks
// the track for long. Requests that find a live lease held elsewhere stream
// live without persisting.

model PersistLease {
  trackId   String
  bitrate   Int
  holder    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@id([trackId, bitrate])
  @@index([expiresAt])
  @@map("persist_lease")
}

// ─── Recent Plays (Spotify-like history; counted at 30s of playback) ───

model RecentPlay {
  id        String   @id @default(cuid())
  userId    String
  trackId   String
  title     String
  artist    String
  album     String?
  albumId   String?
  coverUrl  String?
  duration  Int?
  playedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId, playedAt(sort: Desc)])
  @@map("recent_play")
}

// ─── External → Deezer track match cache ───
//
// Cross-platform suggestion engine: Spotify (or other sources) feed the
// autocomplete and search-enrichment flows; we cache the resolved Deezer
// trackId here so repeated suggestions don't re-pay the matching cost.
//
// `deezerTrackId` is null when the matcher couldn't find anything on Deezer
// (kept as a negative cache for `NEG_TTL_MS`, see search/resolve route).

model TrackMatch {
  id            String   @id @default(cuid())
  source        String   // "spotify"
  sourceId      String   // e.g. Spotify track ID
  isrc          String?
  deezerTrackId String?
  strategy      String?  // "isrc" | "advanced" | "advanced-clean" | "fuzzy" | "not_found"
  confidence    Float?
  resolvedAt    DateTime @default(now())

  @@unique([source, sourceId])
  @@index([isrc])
  @@map("track_match")
}

// ─── Track Sharing ───
//
// Public share links for individual tracks. The file may be evicted from S3
// after the share is created — playback falls back to re-streaming via the
// progressive engine using the share creator's stored Deezer credentials.

model SharedTrack {
  id            String    @id @default(cuid())
  shareId       String    @unique
  trackId       String
  userId        String
  title         String
  artist        String
  album         String?
  coverUrl      String?
  duration      Int?
  storedTrackId String?
  expiresAt     DateTime?
  plays         Int       @default(0)
  createdAt     DateTime  @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storedTrack StoredTrack? @relation(fields: [storedTrackId], references: [id])

  @@unique([userId, trackId]) // one link per user and track (POST /shares reuses it)
  @@index([userId])
  @@index([trackId])
  @@map("shared_track")
}
