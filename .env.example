# On Vercel these are set in Project → Settings → Environment Variables.
# Locally: `vercel link && vercel env pull .env.local` fetches them all.

# ── PostgreSQL (required — Vercel Marketplace: Neon) ──
# Pooled connection string, injected automatically when the Neon
# integration is connected to the project.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ── Cloudflare R2 (required — private bucket for the audio files) ──
# S3 credentials of an account API token scoped to the bucket with
# "Workers R2 Storage Bucket Item Write": the access key id is the token id,
# the secret is the SHA-256 (hex) of the token value. Production/Preview use
# the bucket "wavelet-music", Development "wavelet-music-dev" (see docs/vercel.md).
R2_ACCOUNT_ID=
R2_BUCKET=wavelet-music-dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Escape hatch: stream every track through /api/v1/stream instead of handing
# the browser a presigned R2 URL.
# WAVELET_DISABLE_PRESIGNED_URLS=1

# ── Better Auth ──
# Also the fallback key for the stored Deezer ARLs (see WAVELET_ENCRYPTION_KEY).
BETTER_AUTH_SECRET=change-me-to-a-random-64-char-secret-key-for-production
# Production URL of the deployment (https://wavelet.titosy.dev)
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Multi-device playback (optional) ──
# Convex holds the Playback Session and the Devices (docs/adr/0001). Without it
# each tab plays on its own. Local: `CONVEX_AGENT_MODE=anonymous npx convex dev`
# writes both values to .env.local; set BETTER_AUTH_URL on the deployment too
# (`npx convex env set BETTER_AUTH_URL http://localhost:3000`), Convex fetches the
# JWT keys from ${BETTER_AUTH_URL}/api/auth/jwks (docs/adr/0002).
# CONVEX_DEPLOYMENT=
# NEXT_PUBLIC_CONVEX_URL=

# ── Deezer ARL encryption at rest (optional, recommended) ──
# Stored ARLs are encrypted with AES-256-GCM ("enc:v1:..."). Key = this value
# (base64 of 32 random bytes: `openssl rand -base64 32`), else derived from
# BETTER_AUTH_SECRET. Use the SAME value in every environment that shares the
# database (Production and Preview): a value encrypted with one key cannot be
# read with another, and those users would have to paste their ARL again.
# Changing or removing this key has the same effect.
# WAVELET_ENCRYPTION_KEY=

# ── Server-wide streaming quality (optional) ──
# Comma-separated emails allowed to change it (POST /api/v1/settings/quality).
# Unset: any signed-in user can.
# WAVELET_ADMIN_EMAILS=you@example.com

# ── Storage garbage collection (optional) ──
# Daily Vercel Cron GET /api/v1/internal/gc (vercel.json) sends
# "Authorization: Bearer $CRON_SECRET". Unset: the route does nothing.
# CRON_SECRET=

# ── Guest browsing (optional: shared Deezer ARL for unauthenticated users) ──
# WAVELET_SERVICE_ARL=

# ── Spotify (optional) ──
# "Import from Spotify" works without these: it reads the public embed page
# (first 100 tracks, no ISRC). Since Feb 2026, Development Mode apps no longer
# get the tracks of playlists they don't own, so credentials only help an app
# with extended quota (full list + ISRC matching).
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# ── Last.fm (optional: similar tracks for autoplay and the Daily Mix) ──
# Free key at https://www.last.fm/api/account/create (non-commercial use).
# Unset: Last.fm is skipped; ListenBrainz (no key) and Deezer's radios still feed them.
# LASTFM_API_KEY=
